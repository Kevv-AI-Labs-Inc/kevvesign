{
  "name": "@esign/bridge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup src/main.ts src/cli/import-packages.ts --format esm --platform node --target node22 --clean --sourcemap",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test:native": "node --import tsx src/__tests__/native-db.integration.ts",
    "import:packages": "node --import tsx src/cli/import-packages.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.12.4",
    "fflate": "0.8.3",
    "pg": "^8.16.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "tsup": "^8.5.0"
  },
  "files": [
    "dist"
  ]
}
