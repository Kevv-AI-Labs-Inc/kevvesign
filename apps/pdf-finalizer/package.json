{
  "name": "@esign/pdf-finalizer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsup src/main.ts --format esm --platform node --target node22 --clean --sourcemap",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@esign/domain": "workspace:*",
    "@esign/infrastructure": "workspace:*",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  }
}
