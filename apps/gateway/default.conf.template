map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}
server {
  listen 8080;
  server_name _;
  server_tokens off;
  client_max_body_size 30m;
  # Recipient tokens are part of native paths. Do not log request URLs.
  access_log off;
  error_log /dev/stderr crit;
  resolver ${DNS_RESOLVER} valid=30s ipv6=off;
  add_header X-Signing-Engine Documenso always;
  location = /health/gateway {
    default_type application/json;
    return 200 '{"engine":"documenso","role":"gateway"}';
  }
  location / {
    set $native_host ${DOCUMENSO_ORIGIN_HOST};
    proxy_pass https://$native_host$request_uri;
    proxy_http_version 1.1;
    proxy_ssl_server_name on;
    proxy_ssl_name $native_host;
    proxy_ssl_verify on;
    proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
    proxy_ssl_verify_depth 3;
    proxy_set_header Host $native_host;
    proxy_set_header X-Forwarded-Host ${PUBLIC_SIGNING_HOST};
    proxy_set_header X-Forwarded-Proto https;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;
    proxy_buffering off;
    proxy_redirect https://${DOCUMENSO_ORIGIN_HOST}/ https://${PUBLIC_SIGNING_HOST}/;
    proxy_cookie_domain ${DOCUMENSO_ORIGIN_HOST} ${PUBLIC_SIGNING_HOST};
  }
}
