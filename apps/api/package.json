{
  "name": "@esign/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsup src/main.ts --format esm --platform node --target node22 --clean --sourcemap",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@esign/contracts": "workspace:*",
    "@esign/domain": "workspace:*",
    "@esign/infrastructure": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.6.0",
    "jose": "^6.1.0",
    "pdf-lib": "^1.17.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "tsup": "^8.5.0"
  }
}
